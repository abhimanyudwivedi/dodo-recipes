# Postgres (Neon or Supabase free tier)
DATABASE_URL=postgres://user:password@host/db

# Shared secret: the cron pinger sends "Authorization: Bearer <this>"
CRON_SECRET=make-a-long-random-string

# The address you send from. Use a separate domain for cold email, never your product's main domain.
MAIL_FROM=you@yourcoldomain.com
MAIL_PROVIDER=zoho            # zoho (send, reply in thread, reply detection) | resend (send only)

# Zoho Mail (Self Client OAuth, scopes ZohoMail.messages.ALL + ZohoMail.accounts.READ)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API=https://mail.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=

# Resend (if MAIL_PROVIDER=resend)
RESEND_API_KEY=
